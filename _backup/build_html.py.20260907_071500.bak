#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
md 교안 -> 웹 교안 html 자동 변환 스크립트

사용법:
    python build_html.py

01_교안 폴더의 00_개요.md / 01_Part1_*.md / 02_Part2_*.md / 03_Part3_*.md 를 읽어서
07_산출물/PrivateLLMInfra_웹교안.html 을 다시 만든다.
덮어쓰기 전에 기존 html은 _backup/07_산출물/ 에 타임스탬프를 붙여 자동 백업한다.

md 작성 규칙 (이 규칙을 지켜야 정확히 변환된다):
  # PART N. 제목                 -> 파트 제목
  (제목 아래 첫 문단)             -> 파트 소개 문단 (선택)
  ## 학습 목표                   -> 불릿 목록
  ## 시간 배분 (...)             -> 표
  ## 도입 (...)                  -> 따옴표로 감싼 강사 멘트 한 문단
  ## 전개
    ### N-M. 소제목 (X분)        -> 소단원 카드
      (소단원 첫 문단)            -> 소개 문단 (선택)
      표 / 불릿 목록              -> 그대로 렌더링
      **비유로 설명하기**: ...    -> 비유 박스
      **확인 질문**: "..."        -> 확인 질문 박스 (— 뒤 강사용 메모는 자동 생략)
  ## 정리 (...)                  -> 따옴표로 감싼 강사 멘트
      **확인 질문**: ...          -> 확인 질문 박스
      **다음 파트 예고**: ... 또는 **전체 마무리 멘트**: ... -> 다음 파트 안내 박스
"""

import base64
import html
import mimetypes
import re
import shutil
import sys
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent
MD_DIR = ROOT / "01_교안"
OUT_DIR = ROOT / "07_산출물"
OUT_FILE = OUT_DIR / "PrivateLLMInfra_웹교안.html"
BACKUP_DIR = ROOT / "_backup" / "07_산출물"
IMG_DIR = ROOT / "02_이미지"


# ---------------------------------------------------------------- utilities

def esc(text: str) -> str:
    return html.escape(text.strip(), quote=False)


BR_PLACEHOLDER = "\x00BR\x00"


def inline_md(text: str) -> str:
    """**bold** -> <strong>, md 안의 <br> -> 줄바꿈, 나머지는 escape."""
    text = text.strip()
    text = re.sub(r"<br\s*/?>", BR_PLACEHOLDER, text, flags=re.I)
    parts = re.split(r"(\*\*.+?\*\*)", text)
    out = []
    for p in parts:
        m = re.match(r"^\*\*(.+)\*\*$", p, re.S)
        if m:
            out.append(f"<strong>{html.escape(m.group(1), quote=False)}</strong>")
        else:
            out.append(html.escape(p, quote=False))
    result = "".join(out)
    result = result.replace(BR_PLACEHOLDER, "<br>")
    result = result.replace("\n", "<br>")  # 실제 줄바꿈도 그대로 살린다
    return result


def strip_blockquote(text: str) -> str:
    """'> ' 로 시작하는 인용 블록 표시를 제거한다 (내용은 그대로 유지)."""
    lines = []
    for line in text.split("\n"):
        stripped = line.strip()
        if stripped.startswith(">"):
            stripped = stripped[1:]
            if stripped.startswith(" "):
                stripped = stripped[1:]
            lines.append(stripped)
        else:
            lines.append(line)
    return "\n".join(lines)


def split_question_note(text: str):
    """'"질문..." — 답변 방향' 형태를 (질문, 답변 방향) 으로 분리한다.
    둘 다 화면에 표시한다 (— 뒤도 md에 쓰신 내용이므로 생략하지 않는다)."""
    text = text.strip()
    parts = re.split(r"\s+—\s+", text, maxsplit=1)
    question = parts[0].strip().strip('"')
    note = parts[1].strip() if len(parts) > 1 else ""
    return question, note


TABLE_RE = re.compile(r"^\|.*\|\s*$")


def split_blocks(body: str):
    """문단 단위로 body를 분해한다. 표/리스트/일반 문단을 구분해 리스트로 반환.
    각 항목: ('p', text) | ('table', [[cell,...], ...]) | ('ul', [text,...])
    """
    lines = [l for l in body.split("\n")]
    blocks = []
    i = 0
    n = len(lines)
    while i < n:
        line = lines[i].strip()
        if not line:
            i += 1
            continue
        m_fence = FENCE_RE.match(line)
        if m_fence:
            lang = m_fence.group(1)
            code_lines = []
            i += 1
            while i < n and lines[i].strip() != "```":
                code_lines.append(lines[i])
                i += 1
            if i < n:
                i += 1  # 닫는 ``` 건너뛰기
            blocks.append(("code", (lang, "\n".join(code_lines))))
            continue
        m_img_wiki = IMG_WIKI_RE.match(line)
        m_img_md = IMG_MD_RE.match(line)
        if m_img_wiki:
            blocks.append(("img", (m_img_wiki.group(1).strip(), m_img_wiki.group(2), "")))
            i += 1
            continue
        if m_img_md:
            blocks.append(("img", (m_img_md.group(2).strip(), None, m_img_md.group(1).strip())))
            i += 1
            continue
        if TABLE_RE.match(line):
            tbl_lines = []
            while i < n and TABLE_RE.match(lines[i].strip()):
                tbl_lines.append(lines[i].strip())
                i += 1
            rows = [
                [c.strip() for c in l.strip("|").split("|")]
                for l in tbl_lines
            ]
            # 두번째 줄은 --- 구분선
            header = rows[0]
            body_rows = [r for r in rows[2:]] if len(rows) > 2 else []
            blocks.append(("table", (header, body_rows)))
            continue
        if line.startswith("- ") or line.startswith("* "):
            items = []
            while i < n:
                cur = lines[i].strip()
                if cur.startswith("- ") or cur.startswith("* "):
                    items.append(cur[2:].strip())
                    i += 1
                elif (
                    cur and items
                    and not TABLE_RE.match(cur)
                    and not re.match(r"^#{1,6}\s", cur)
                    and not IMG_WIKI_RE.match(cur)
                    and not IMG_MD_RE.match(cur)
                    and not FENCE_RE.match(cur)
                ):
                    # 빈 줄 없이 이어지는 줄은 바로 앞 항목의 이어지는 내용(느슨한 연속)으로 합친다
                    items[-1] = items[-1] + "\n" + cur
                    i += 1
                else:
                    break
            blocks.append(("ul", items))
            continue
        if re.match(r"^\d+\.\s", line):
            items = []
            while i < n and re.match(r"^\d+\.\s", lines[i].strip()):
                items.append(re.sub(r"^\d+\.\s", "", lines[i].strip()))
                i += 1
            blocks.append(("ol", items))
            continue
        # 일반 문단: 다음 빈 줄 / 표 / 리스트 전까지 이어붙인다
        para_lines = [line]
        i += 1
        while i < n and lines[i].strip() and not TABLE_RE.match(lines[i].strip()) \
                and not lines[i].strip().startswith("- ") and not re.match(r"^\d+\.\s", lines[i].strip()) \
                and not IMG_WIKI_RE.match(lines[i].strip()) and not IMG_MD_RE.match(lines[i].strip()) \
                and not FENCE_RE.match(lines[i].strip()):
            para_lines.append(lines[i].strip())
            i += 1
        blocks.append(("p", " ".join(para_lines)))
    return blocks


def render_table(header, rows, css_class=""):
    cls = f' class="{css_class}"' if css_class else ""
    th = "".join(f"<th>{inline_md(h)}</th>" for h in header)
    trs = []
    for r in rows:
        tds = "".join(f"<td>{inline_md(c)}</td>" for c in r)
        trs.append(f"<tr>{tds}</tr>")
    return f'<table{cls}>\n<tr>{th}</tr>\n' + "\n".join(trs) + "\n</table>"


def split_label_desc(text: str):
    """'**라벨**: 설명' 또는 '라벨: 설명' 형태를 (라벨, 설명)으로 나눈다.
    **...** 굵게 표시 안에 있는 ':'에서는 절대 자르지 않는다 (굵게 표시가 깨지는 것을 막기 위함).
    콜론 형태가 아니면 None을 반환한다."""
    text = text.strip()
    m = re.match(r"^\*\*(.+?)\*\*\s*[:：]?\s*(.*)$", text, re.S)
    if m and m.group(2).strip():
        label = m.group(1).rstrip(":：").strip()
        return label, m.group(2).strip()

    # **...** 구간을 임시로 치환해 그 안의 ':'를 건너뛰고 바깥쪽 ':'만 찾는다
    placeholders = []

    def stash(mm):
        placeholders.append(mm.group(0))
        return f"\x00{len(placeholders) - 1}\x00"

    tmp = re.sub(r"\*\*.+?\*\*", stash, text, flags=re.S)

    def unstash(s):
        return re.sub(r"\x00(\d+)\x00", lambda mm: placeholders[int(mm.group(1))], s)

    for sep in (":", "：", " — "):
        if sep in tmp:
            idx = tmp.index(sep)
            label = unstash(tmp[:idx]).strip()
            desc = unstash(tmp[idx + len(sep):]).strip()
            if label and desc:
                return label, desc
    return None


def render_ul_as_terms(items):
    """'라벨: 설명' 형태 불릿이면 term-row 로, 아니면 note-list 로."""
    parsed = [split_label_desc(it) for it in items]
    if items and all(p is not None for p in parsed):
        rows = []
        for label, desc in parsed:
            rows.append(
                f'<div class="term-row"><span class="term-chip">{inline_md(label)}</span>'
                f'<span class="term-desc">{inline_md(desc)}</span></div>'
            )
        return "\n".join(rows)
    lis = "\n".join(f"<li>{inline_md(it)}</li>" for it in items)
    return f'<ul class="note-list">\n{lis}\n</ul>'


def render_qcheck(label, question, note):
    label_html = esc(label)
    html_out = f'<div class="qcheck"><strong>{label_html}:</strong> &quot;{inline_md(question)}&quot;'
    if note:
        html_out += f'<span class="qcheck-note"><b>답변 방향.</b> {inline_md(note)}</span>'
    html_out += '</div>'
    return html_out


def render_ol(items):
    lis = "\n".join(f"<li>{inline_md(it)}</li>" for it in items)
    return f'<ol class="flow">\n{lis}\n</ol>'


IMG_WIKI_RE = re.compile(r"^!\[\[([^\]|]+)(?:\|(\d+))?\]\]\s*$")
IMG_MD_RE = re.compile(r"^!\[([^\]]*)\]\(([^)]+)\)\s*$")
FENCE_RE = re.compile(r"^```\s*([A-Za-z0-9_+-]*)\s*$")


def find_image(name: str):
    """이미지 파일명(또는 상대 경로)으로 실제 파일을 찾는다.
    02_이미지 폴더 -> 프로젝트 루트 -> 01_교안 폴더 순서로 찾는다."""
    name = name.strip()
    search_dirs = [IMG_DIR, ROOT, MD_DIR]
    candidates = []
    for d in search_dirs:
        candidates.append(d / name)
        candidates.append(d / Path(name).name)
    for c in candidates:
        if c.exists() and c.is_file():
            return c
    return None


def img_to_data_uri(path: Path) -> str:
    mime, _ = mimetypes.guess_type(str(path))
    if not mime:
        mime = "image/png"
    data = base64.b64encode(path.read_bytes()).decode("ascii")
    return f"data:{mime};base64,{data}"


def render_image(fname: str, width, alt: str) -> str:
    path = find_image(fname)
    if path is None:
        return (
            '<div style="padding:8px 12px; margin:8px 0; border:1px dashed #c0392b; '
            f'color:#c0392b; font-size:12px; border-radius:6px;">'
            f'이미지를 찾을 수 없습니다: {esc(fname)} (02_이미지 폴더에 넣어주세요)</div>'
        )
    data_uri = img_to_data_uri(path)
    style = "max-width:100%; border-radius:8px; display:block; margin:10px auto;"
    if width:
        style = f"width:{width}px; max-width:100%; border-radius:8px; display:block; margin:10px auto;"
    alt_html = esc(alt) if alt else ""
    return f'<img src="{data_uri}" alt="{alt_html}" style="{style}">'


def render_code(lang: str, code: str) -> str:
    escaped = html.escape(code, quote=False)
    lang_attr = f' data-lang="{esc(lang)}"' if lang else ""
    return (
        '<pre style="background:#241b1e; color:#f5eef0; border-radius:10px; '
        'padding:14px 16px; overflow-x:auto; font-size:12.5px; line-height:1.55; '
        'margin:10px 0; white-space:pre;"><code' + lang_attr + '>' + escaped + '</code></pre>'
    )


def render_blocks(blocks, table_class=""):
    out = []
    for kind, data in blocks:
        if kind == "p":
            out.append(f'<p style="font-size:13.5px; color:#3a3436; margin:0 0 10px;">{inline_md(data)}</p>')
        elif kind == "table":
            header, rows = data
            out.append(render_table(header, rows, table_class))
        elif kind == "ul":
            out.append(render_ul_as_terms(data))
        elif kind == "ol":
            out.append(render_ol(data))
        elif kind == "img":
            fname, width, alt = data
            out.append(render_image(fname, width, alt))
        elif kind == "code":
            lang, code = data
            out.append(render_code(lang, code))
    return "\n".join(out)


# ---------------------------------------------------------------- md parsing

H1_RE = re.compile(r"^#\s+(.+)$", re.M)
H2_RE = re.compile(r"^##\s+(.+)$", re.M)
H3_RE = re.compile(r"^###\s+(.+)$", re.M)


def split_by_heading(text, pattern):
    """pattern(H1/H2/H3)로 text를 (제목, 본문) 리스트로 나눈다. 맨 앞 프리앰블도 포함."""
    matches = list(pattern.finditer(text))
    sections = []
    if not matches:
        return [(None, text)]
    if matches[0].start() > 0:
        sections.append((None, text[: matches[0].start()]))
    for idx, m in enumerate(matches):
        start = m.end()
        end = matches[idx + 1].start() if idx + 1 < len(matches) else len(text)
        sections.append((m.group(1).strip(), text[start:end]))
    return sections


def parse_subsections(subsections):
    """### N-M. 소제목 리스트를 카드 데이터로 변환."""
    parsed_subs = []
    for name, body in subsections:
        if name is None:
            continue
        num_m = re.match(r"([\d]+-[\d]+)\.\s*(.+)", name)
        if num_m:
            num, subtitle = num_m.group(1), num_m.group(2)
        else:
            num, subtitle = "", name
        subtitle = re.sub(r"\s*\([^)]*분[^)]*\)\s*$", "", subtitle).strip()

        analogy = ""
        analogy_label = "비유로 설명하기"
        qcheck = ""
        qcheck_note = ""
        qcheck_label = "확인 질문"
        b = body
        am = re.search(r"\*\*(비유[^*\n]*)\*\*\s*[:：]\s*(.+?)(?=\n\n|\Z)", b, re.S)
        if am:
            analogy_label = am.group(1).strip()
            analogy = am.group(2).strip()
            b = b[: am.start()] + b[am.end():]
        qm = re.search(r"\*\*(확인 질문[^*\n]*)\*\*\s*[:：]\s*(.+?)(?=\n\n|\Z)", b, re.S)
        if qm:
            qcheck_label = qm.group(1).strip()
            qcheck, qcheck_note = split_question_note(qm.group(2))
            b = b[: qm.start()] + b[qm.end():]

        qexplain_label = ""
        qexplain_blocks = []
        em = re.search(r"\*\*([^*\n]*설명[^*\n]*)\*\*\s*[:：]\s*(.+?)(?=\n\n\*\*|\Z)", b, re.S)
        if em:
            qexplain_label = em.group(1).strip()
            qexplain_blocks = split_blocks(em.group(2))
            b = b[: em.start()] + b[em.end():]

        blocks = split_blocks(b)
        parsed_subs.append({
            "num": num,
            "title": subtitle.strip(" —"),
            "blocks": blocks,
            "analogy": analogy,
            "analogy_label": analogy_label,
            "qcheck": qcheck,
            "qcheck_note": qcheck_note,
            "qcheck_label": qcheck_label,
            "qexplain_label": qexplain_label,
            "qexplain_blocks": qexplain_blocks,
        })
    return parsed_subs


def parse_part(md_text: str):
    """PART md 하나를 파싱해서 dict로 반환한다.
    md에 등장하는 ## 섹션 순서를 그대로 유지해서 렌더링하기 위해,
    'ordered' 리스트에 문서에 나온 순서대로 카드 데이터를 쌓는다."""
    h1 = H1_RE.search(md_text)
    title = h1.group(1).strip() if h1 else ""
    rest = md_text[h1.end():] if h1 else md_text

    h2_sections = split_by_heading(rest, H2_RE)
    intro = ""
    ordered = []

    for name, body in h2_sections:
        body = body.strip("\n")
        if name is None:
            blocks = split_blocks(body)
            paras = [b[1] for b in blocks if b[0] == "p"]
            intro = " ".join(paras)
        elif name.startswith("학습 목표"):
            blocks = split_blocks(body)
            goals = []
            for kind, data in blocks:
                if kind == "ul":
                    goals.extend(data)
            ordered.append({"kind": "goals", "items": goals})
        elif name.startswith("시간 배분"):
            time_table = None
            blocks = split_blocks(body)
            for kind, data in blocks:
                if kind == "table":
                    time_table = data
            if time_table:
                ordered.append({"kind": "time_table", "table": time_table})
        elif name.startswith("도입"):
            label = "도입"
            m = re.search(r"\(([^)]+)\)", name)
            if m:
                label = f"도입 · {m.group(1)}"
            q = re.search(r'"(.+)"', body, re.S)
            script = q.group(1).strip() if q else body.strip()
            ordered.append({"kind": "stage", "label": label, "script": script})
        elif name.startswith("전개"):
            subsections = split_by_heading(body, H3_RE)
            ordered.append({"kind": "subsections", "items": parse_subsections(subsections)})
        elif name.startswith("정리"):
            label = "정리"
            m = re.search(r"\(([^)]+)\)", name)
            if m:
                label = f"정리 · {m.group(1)}"
            q = re.search(r'"(.+?)"', body, re.S)
            script = q.group(1).strip() if q else ""
            after_script = body[q.end():] if q else body
            qcheck = ""
            qcheck_note = ""
            qcheck_label = "확인 질문"
            qm = re.search(r"\*\*(확인 질문[^*\n]*)\*\*\s*[:：]\s*(.+)", after_script)
            if qm:
                qcheck_label = qm.group(1).strip()
                qcheck, qcheck_note = split_question_note(qm.group(2))
            qexplain_label = ""
            qexplain_blocks = []
            em = re.search(
                r"\*\*([^*\n]*설명[^*\n]*)\*\*\s*[:：]\s*(.+?)(?=\n*\*\*(?:다음 파트 예고|전체 마무리 멘트)\*\*|\Z)",
                after_script, re.S,
            )
            if em:
                qexplain_label = em.group(1).strip()
                qexplain_blocks = split_blocks(em.group(2))
            tip_label = "다음 파트 예고"
            tip = ""
            tm = re.search(r"\*\*(다음 파트 예고|전체 마무리 멘트)\*\*\s*[:：]\s*(.+)", after_script, re.S)
            if tm:
                tip_label = tm.group(1)
                tip = tm.group(2).strip().strip('"')
            ordered.append({
                "kind": "stage", "label": label, "script": script,
                "qcheck": qcheck, "qcheck_note": qcheck_note, "qcheck_label": qcheck_label,
                "qexplain_label": qexplain_label, "qexplain_blocks": qexplain_blocks,
                "tip_label": tip_label, "tip": tip,
            })
        else:
            ordered.append({
                "kind": "extra",
                "title": name.strip(),
                "blocks": split_blocks(strip_blockquote(body)),
            })

    return {"title": title, "intro": intro, "ordered": ordered}


# ---------------------------------------------------------------- section html

def render_part_section(section_id, part, part_tag):
    out = [f'  <section class="section" id="{section_id}">']
    out.append('    <div class="section-head">')
    out.append(f'      <h2>{esc(part["title"])}</h2>')
    out.append(f'      <span class="part-tag">{esc(part_tag)}</span>')
    out.append('    </div>')
    if part["intro"]:
        out.append(f'    <p class="section-sub">{inline_md(part["intro"])}</p>')
    out.append("")

    # md에 등장한 ## 섹션 순서 그대로 렌더링한다.
    for block in part["ordered"]:
        kind = block["kind"]

        if kind == "goals":
            if not block["items"]:
                continue
            out.append('    <div class="goal-box">')
            out.append('      <h3>학습 목표</h3>')
            out.append('      <ul>')
            for g in block["items"]:
                out.append(f'        <li>{inline_md(g.rstrip("."))}</li>')
            out.append('      </ul>')
            out.append('    </div>')
            out.append("")

        elif kind == "time_table":
            header, rows = block["table"]
            out.append('    <div class="card">')
            out.append('      <h3>시간 배분</h3>')
            out.append("      " + render_table(header, rows, "time-table").replace("\n", "\n      "))
            out.append('    </div>')
            out.append("")

        elif kind == "stage":
            if not (block.get("script") or block.get("qcheck") or block.get("tip")):
                continue
            out.append('    <div class="card">')
            out.append(f'      <span class="stage-label">{esc(block["label"])}</span>')
            if block.get("script"):
                out.append(f'      <div class="script">&quot;{inline_md(block["script"])}&quot;</div>')
            if block.get("qcheck"):
                out.append("      " + render_qcheck(
                    block.get("qcheck_label", "확인 질문"), block["qcheck"], block.get("qcheck_note", "")
                ))
            if block.get("qexplain_blocks"):
                elabel = esc(block.get("qexplain_label") or "설명")
                erendered = render_blocks(block["qexplain_blocks"])
                if erendered:
                    out.append(f'      <div class="tip"><strong>{elabel}:</strong>')
                    out.append('        <div style="margin-top:8px;">')
                    out.append("          " + erendered.replace("\n", "\n          "))
                    out.append('        </div>')
                    out.append('      </div>')
            if block.get("tip"):
                tip_label = esc(block["tip_label"])
                out.append(f'      <div class="tip"><strong>{tip_label}:</strong> &quot;{inline_md(block["tip"])}&quot;</div>')
            out.append('    </div>')
            out.append("")

        elif kind == "extra":
            out.append('    <div class="card">')
            out.append(f'      <h3>{inline_md(block["title"])}</h3>')
            rendered = render_blocks(block["blocks"])
            if rendered:
                out.append("      " + rendered.replace("\n", "\n      "))
            else:
                out.append('      <p style="font-size:13.5px; color:var(--muted); margin:0;">(작성 중)</p>')
            out.append('    </div>')
            out.append("")

        elif kind == "subsections":
            for sub in block["items"]:
                out.append('    <div class="card">')
                num_html = f'<span class="num">{esc(sub["num"])}</span>' if sub["num"] else ""
                out.append(f'      <h3>{num_html}{inline_md(sub["title"])}</h3>')
                rendered = render_blocks(sub["blocks"])
                if rendered:
                    out.append("      " + rendered.replace("\n", "\n      "))
                if sub["analogy"]:
                    alabel = esc(sub.get("analogy_label", "비유로 설명하기"))
                    out.append(f'      <div class="analogy"><strong>{alabel}:</strong> {inline_md(sub["analogy"])}</div>')
                if sub["qcheck"]:
                    out.append("      " + render_qcheck(
                        sub.get("qcheck_label", "확인 질문"), sub["qcheck"], sub.get("qcheck_note", "")
                    ))
                if sub.get("qexplain_blocks"):
                    elabel = esc(sub.get("qexplain_label") or "설명")
                    erendered = render_blocks(sub["qexplain_blocks"])
                    if erendered:
                        out.append(f'      <div class="tip"><strong>{elabel}:</strong>')
                        out.append('        <div style="margin-top:8px;">')
                        out.append("          " + erendered.replace("\n", "\n          "))
                        out.append('        </div>')
                        out.append('      </div>')
                out.append('    </div>')
                out.append("")

    out.append('  </section>')
    return "\n".join(out)


# ---------------------------------------------------------------- 00_개요.md

def parse_overview(md_text: str):
    h1 = H1_RE.search(md_text)
    rest = md_text[h1.end():] if h1 else md_text
    sections = {name: body for name, body in split_by_heading(rest, H2_RE) if name}
    return sections


def render_overview_section(sections):
    out = ['  <section class="section active" id="s-overview">']
    out.append('    <div class="section-head"><h2>강의 개요</h2></div>')

    axis_rows = []
    for name, body in sections.items():
        if name.startswith("강의 핵심 내용"):
            blocks = split_blocks(body)
            tables = [d for k, d in blocks if k == "table"]
            if tables:
                axis_rows = tables[0][1]

    if axis_rows:
        out.append('    <p class="section-sub">이번 강의에서는 Private LLM Infra를 세 개의 축으로 나누어 살펴본다.</p>')
        out.append('    <div class="grid-2">')
        for idx, (axis, meaning) in enumerate(axis_rows, start=1):
            out.append('      <div class="card">')
            out.append(f'        <h3><span class="num">{idx}</span>{inline_md(axis)}</h3>')
            out.append(f'        <p style="margin:0; font-size:13.5px; color:#3a3436;">{inline_md(meaning)}</p>')
            out.append('      </div>')
        for name, body in sections.items():
            if name.startswith("강의 개요"):
                blocks = split_blocks(body)
                for kind, data in blocks:
                    if kind == "table":
                        header, rows = data
                        out.append('      <div class="card">')
                        out.append('        <h3>강의 개요표</h3>')
                        rows_html = "\n".join(
                            f"          <tr><th>{inline_md(r[0])}</th><td>{inline_md(r[1])}</td></tr>"
                            for r in rows
                        )
                        out.append('        <table>')
                        out.append(rows_html)
                        out.append('        </table>')
                        out.append('      </div>')
        out.append('    </div>')
        out.append("")

    for name, body in sections.items():
        if name.startswith("강의 핵심 내용"):
            blocks = split_blocks(body)
            tables = [d for k, d in blocks if k == "table"]
            if len(tables) >= 2:
                header, rows = tables[1]
                out.append('    <div class="card">')
                out.append('      <h3>파트 구성</h3>')
                out.append("      " + render_table(header, rows).replace("\n", "\n      "))
                out.append('    </div>')
                out.append("")

    for name, body in sections.items():
        if name.startswith("전체 진행 시나리오"):
            blocks = split_blocks(body)
            out.append('    <div class="card">')
            out.append(f'      <h3>{esc(re.sub(r"^전체 진행 시나리오", "전체 진행 시나리오", name))}</h3>')
            for kind, data in blocks:
                if kind == "table":
                    header, rows = data
                    out.append("      " + render_table(header, rows, "time-table").replace("\n", "\n      "))
            for oname, obody in sections.items():
                if oname.startswith("오프닝 멘트"):
                    q = re.search(r'"(.+)"', obody, re.S)
                    if q:
                        out.append(f'      <div class="script">&quot;{inline_md(q.group(1))}&quot;</div>')
            out.append('    </div>')
            out.append("")

    for name, body in sections.items():
        if name.startswith("파트 전환 멘트"):
            out.append('    <div class="card">')
            out.append(f'      <h3>{esc(name)}</h3>')
            blocks = split_blocks(body)
            for kind, data in blocks:
                if kind == "ul":
                    for it in data:
                        out.append(f'      <div class="script">{inline_md(it)}</div>')
            out.append('    </div>')
            out.append("")

    for name, body in sections.items():
        if name.startswith("예상 질문"):
            blocks = split_blocks(body)
            out.append('    <div class="card">')
            out.append(f'      <h3>{esc(name)}</h3>')
            for kind, data in blocks:
                if kind == "table":
                    header, rows = data
                    out.append("      " + render_table(header, rows).replace("\n", "\n      "))
            out.append('    </div>')
            out.append("")

    out.append('  </section>')
    return "\n".join(out)


def render_guide_section(sections):
    out = ['  <section class="section" id="s-guide">']
    out.append('    <div class="section-head"><h2>강의 시연 안내</h2></div>')

    notes = []
    examples = []
    for name, body in sections.items():
        if name.startswith("시연 안내"):
            blocks = split_blocks(body)
            for kind, data in blocks:
                if kind == "ul":
                    for it in data:
                        m = re.match(r"예시\s*\d+\s*[:：]\s*(.+)", it)
                        if m:
                            examples.append(it)
                        else:
                            notes.append(it)
    if notes:
        out.append('    <div class="card">')
        out.append('      <ul class="note-list">')
        for n in notes:
            out.append(f'        <li>{inline_md(n)}</li>')
        out.append('      </ul>')
        out.append('    </div>')
        out.append("")
    if examples:
        out.append('    <div class="card">')
        out.append('      <h3>시연 구성 예시</h3>')
        for e in examples:
            out.append(f'      <span class="example-pill">{inline_md(e)}</span>')
        out.append('    </div>')

    out.append('  </section>')
    return "\n".join(out)


# ---------------------------------------------------------------- page shell

def load_template():
    if not OUT_FILE.exists():
        sys.exit(f"[오류] 기존 템플릿 {OUT_FILE} 이 없어 스타일을 가져올 수 없습니다.")
    return OUT_FILE.read_text(encoding="utf-8")


def split_template(template: str):
    """<body> 태그 기준으로 head, topbar+hero, footer 이후 꼬리를 그대로 잘라낸다.
    (개별 파트/섹션은 정규식으로 재구성하지 않고 통째로 새로 렌더링하므로,
    여기서는 스타일이 담긴 head 와 topbar/hero, footer/script 블록만 원본 그대로 재사용한다.)"""
    body_idx = template.find("<body>")
    topbar_idx = template.find('<div class="topbar">')
    page_idx = template.find('<div class="page">')
    footer_idx = template.find("<footer>")
    if -1 in (body_idx, topbar_idx, page_idx, footer_idx):
        return None
    head = template[: body_idx + len("<body>")]
    topbar_hero = template[topbar_idx:page_idx]
    tail = template[footer_idx:]
    return head, topbar_hero, tail


def build():
    overview_md = (MD_DIR / "00_개요.md").read_text(encoding="utf-8")
    part1_md = (MD_DIR / "01_Part1_클라우드인프라.md").read_text(encoding="utf-8")
    part2_md = (MD_DIR / "02_Part2_PrivateLLM서빙.md").read_text(encoding="utf-8")
    part3_md = (MD_DIR / "03_Part3_LLMOps.md").read_text(encoding="utf-8")

    sections = parse_overview(overview_md)
    part1 = parse_part(part1_md)
    part2 = parse_part(part2_md)
    part3 = parse_part(part3_md)

    template = load_template()
    parts = split_template(template)
    if parts is None:
        sys.exit("[오류] 기존 html 구조를 인식하지 못했습니다. 템플릿이 변경된 것 같습니다.")
    head, topbar_hero, tail = parts

    body_sections = "\n\n".join([
        render_overview_section(sections),
        render_part_section("s-part1", part1, "팀스파르타 제공 · 원본 유지"),
        render_part_section("s-part2", part2, "학습목표 기반 구성"),
        render_part_section("s-part3", part3, "학습목표 기반 구성"),
        render_guide_section(sections),
    ])

    new_html = (
        head
        + "\n\n"
        + topbar_hero
        + '<div class="page">\n\n'
        + body_sections
        + "\n\n</div>\n\n"
        + tail
    )
    return new_html


def main():
    new_html = build()

    if OUT_FILE.exists():
        BACKUP_DIR.mkdir(parents=True, exist_ok=True)
        stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_path = BACKUP_DIR / f"{OUT_FILE.stem}.{stamp}.bak{OUT_FILE.suffix}"
        shutil.copy2(OUT_FILE, backup_path)
        print(f"[백업] {backup_path}")

    OUT_DIR.mkdir(parents=True, exist_ok=True)
    OUT_FILE.write_text(new_html, encoding="utf-8")
    print(f"[완료] {OUT_FILE} 갱신")


if __name__ == "__main__":
    main()
